# =============================================================================
# Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in real values before running the app.
# NEVER commit .env with real credentials — it is gitignored.
# =============================================================================

# --- SvelteKit / Build -------------------------------------------------------

# Build target: "node" for production server, "static" for GitHub Pages demo
PUBLIC_TARGET=node

# Base path when deployed under a sub-path (e.g. "/xss-app" for GitHub Pages)
PUBLIC_BASE_PATH=

# Set to "true" to prerender all pages (used for static builds)
PUBLIC_PRERENDER_ALL=

# Comma-separated list of origins that SvelteKit should trust for CSRF checks
PUBLIC_TRUSTED_ORIGINS="http://localhost:8080,https://exfldadev01.desy.de,https://european-xfel.github.io"

# Comma-separated list of origins allowed by the CORS middleware
ALLOWED_ORIGINS="http://localhost,https://exfldadev01.desy.de,https://european-xfel.github.io"

# --- Backend ------------------------------------------------------------------

# URL of the Python gRPC backend service
BACKEND_URL=http://localhost:50051

# --- Database (PostgreSQL) ----------------------------------------------------

# PostgreSQL user
DB_USER=postgres

# PostgreSQL password — CHANGE THIS before deploying
DB_PASSWORD=changeme

# PostgreSQL host (use "db" when running inside docker compose)
DB_HOST=localhost

# PostgreSQL database name
DB_NAME=xss-app
