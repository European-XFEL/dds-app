{
  "name": "my-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:seed": "deno run -A src/lib/server/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev --config-dir stories",
    "storybook:build": "storybook build --config-dir stories"
  },
  "devDependencies": {
    "@deno/svelte-adapter": "^0.1.0",
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.39.1",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "drizzle-kit": "^1.0.0-beta.2-0",
    "drizzle-orm": "^1.0.0-beta.2-0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^16.5.0",
    "pyodide": "^0.29.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "typescript-eslint": "^8.48.1",
    "vite-plugin-lucide-preprocess": "^1.4.6"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@deno/vite-plugin": "^1.0.6",
    "@lucide/svelte": "^0.562.0",
    "@paralleldrive/cuid2": "^3.0.6",
    "@sveltejs/adapter-static": "^3.0.10",
    "bits-ui": "^2.15.4",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "katex": "^0.16.27",
    "matterviz": "^0.2.2",
    "paneforge": "^1.0.2",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.7",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.1",
    "zod": "^4.3.6"
  }
}
