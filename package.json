{
  "name": "xss-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "dotenv -e .env -- vite build",
    "build:s": "dotenv -e .env.gh -- vite build",
    "build:g": "dotenv -e .env.gh -- vite build && rm -rf .gh-pages/docs && cp -r build .gh-pages/docs",
    "preview": "dotenv -e .env -- vite preview",
    "preview:s": "dotenv -e .env.gh -- vite preview",
    "prod": "dotenv -e .env -- node build/index.js",
    "prod:s": "caddy run --config ./utils/static.Caddyfile",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --incremental --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --incremental --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check ./src; eslint ./src",
    "format": "prettier --write .",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:seed": "dotenv -e .env -- tsx ./utils/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev --config-dir stories",
    "storybook:build": "storybook build --config-dir stories"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/svelte": "^1.1.3",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.18.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/table-core": "^8.21.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.12.0",
    "@types/papaparse": "^5.5.2",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "1.0.0-beta.9-e89174b",
    "drizzle-orm": "1.0.0-beta.9-e89174b",
    "echarts": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.16.0",
    "globals": "^16.5.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.41",
    "lru-cache": "^11.2.7",
    "matterviz": "^0.3.2",
    "paneforge": "^1.0.2",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.8",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "pyodide": "^0.29.3",
    "rollup-plugin-visualizer": "^6.0.11",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.1",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-lucide-preprocess": "^1.4.8",
    "zod": "^4.3.6"
  }
}
