{
  "name": "my-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "deno run --env-file -A npm:vite dev",
    "_build": "deno run --env-file=$_EF -A npm:vite build",
    "build": "_EF=.env deno task _build && cp ./utils/deno-deploy.json .deno-deploy/deploy.json",
    "build:s": "_EF=.env.gh deno task _build",
    "build:g": "_EF=.env.gh deno task build:s && rm -rf .gh-pages/docs && cp -r build .gh-pages/docs",
    "_preview": "deno run --env-file=$_EF -A npm:vite preview",
    "preview": "_EF=.env deno task _preview",
    "preview:s": "_EF=.env.gh deno task _preview",
    "prod": "deno run --env-file -A .deno-deploy/server.ts",
    "prod:s": "caddy run --config ./utils/caddy-prod-s.json",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:seed": "deno run -A ./scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev --config-dir stories",
    "storybook:build": "storybook build --config-dir stories"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@deno/svelte-adapter": "^0.1.0",
    "@deno/vite-plugin": "^1.0.6",
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.39.1",
    "@internationalized/date": "^3.11.0",
    "@lucide/svelte": "^0.562.0",
    "@paralleldrive/cuid2": "^3.0.6",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/table-core": "^8.21.3",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "bits-ui": "^2.15.4",
    "clsx": "^2.1.1",
    "drizzle-kit": "^1.0.0-beta.2-0",
    "drizzle-orm": "^1.0.0-beta.2-0",
    "echarts": "^6.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^16.5.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.27",
    "matterviz": "^0.3.0",
    "paneforge": "^1.0.2",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.7",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "pyodide": "^0.29.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.3.1",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-lucide-preprocess": "^1.4.6",
    "zod": "^4.3.6"
  }
}