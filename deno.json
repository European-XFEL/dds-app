{
  "exclude": [
    ".deno-deploy",
    ".storybook",
    ".svelte-kit",
    "backend/",
    "src/lib/server/grpc/gen/",
    "src/lib/shadcn",
    "storybook-static"
  ],
  "fmt": {
    "semiColons": true,
    "singleQuote": true
  },
  "unstable": [
    "sloppy-imports"
  ],
  "imports": {
    "$lib/": "./src/lib/",
    "$remote": "./src/lib/remote/dynamic.remote.ts",
    "@std/crypto": "jsr:@std/crypto@^1.0.5",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/path": "jsr:@std/path@^1.1.4"
  },
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ],
    "types": [
      "./.svelte-kit/ambient.d.ts"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-sloppy-imports"
      ]
    }
  }
}