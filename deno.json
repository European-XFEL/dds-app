{
  "exclude": [
    ".storybook",
    ".svelte-kit",
    "backend/",
    "src/lib/server/grpc/gen/",
    "src/lib/shadcn"
  ],
  "fmt": {
    "semiColons": true,
    "singleQuote": true
  },
  "unstable": [
    "fmt-component"
  ],
  "imports": {
    "$data/": "./src/data/",
    "$lib/": "./src/lib/",
    "@std/crypto": "jsr:@std/crypto@^1.0.5",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/path": "jsr:@std/path@^1.1.4"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ]
  }
}