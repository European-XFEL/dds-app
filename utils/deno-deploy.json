{
  "headers": [
    {
      "source": "/_app/immutable/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, immutable, max-age=31536000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs/",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/experiment/detector/",
      "destination": "/experiment/detector",
      "permanent": true
    },
    {
      "source": "/experiment/pump-probe/",
      "destination": "/experiment/pump-probe",
      "permanent": true
    }
  ],
  "rewrites": [],
  "staticFiles": [
    {
      "source": "/docs",
      "destination": ".deno-deploy/static/docs.html"
    },
    {
      "source": "/experiment/detector",
      "destination": ".deno-deploy/static/experiment/detector.html"
    },
    {
      "source": "/experiment/pump-probe",
      "destination": ".deno-deploy/static/experiment/pump-probe.html"
    },
    {
      "source": "/_app/immutable/:file*",
      "destination": ".deno-deploy/static/_app/immutable/:file*"
    },
    {
      "source": "/.gitkeep",
      "destination": ".deno-deploy/static/.gitkeep"
    },
    {
      "source": "/.nojekyll",
      "destination": ".deno-deploy/static/.nojekyll"
    },
    {
      "source": "/favicon.png",
      "destination": ".deno-deploy/static/favicon.png"
    },
    {
      "source": "/offline.html",
      "destination": ".deno-deploy/static/offline.html"
    },
    {
      "source": "/service-worker.js",
      "destination": ".deno-deploy/static/service-worker.js"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": ".deno-deploy/static/manifest.webmanifest"
    }
  ]
}
